---
const faqs = [
	{
		question: 'Je možné TaskFlow AI vyskúšať zadarmo?',
		answer:
			'Áno. Môžete si aktivovať bezplatnú skúšku a otestovať kľúčové funkcie bez zadávania platobných údajov.',
	},
	{
		question: 'Ako funguje umelá inteligencia pri plánovaní?',
		answer:
			'AI analyzuje priority, termíny, závislosti medzi úlohami a dostupnosť tímu. Na základe toho odporučí najefektívnejšie rozdelenie práce.',
	},
	{
		question: 'Môžem predplatné kedykoľvek zrušiť?',
		answer:
			'Áno. Predplatné môžete zrušiť kedykoľvek priamo v účte. Prístup zostane aktívny do konca aktuálneho fakturačného obdobia.',
	},
	{
		question: 'Ponúkate podporu pre tímy?',
		answer:
			'Áno. Poskytujeme podporu pre jednotlivcov aj celé tímy vrátane onboardingu, nastavenia procesov a prioritnej technickej podpory pri vyšších plánoch.',
	},
];
---

<section id="faq" class="border-t border-white/10 bg-slate-950 py-16 sm:py-20 lg:py-28" aria-labelledby="faq-heading">
	<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.25em] text-indigo-300">FAQ</p>
			<h2 id="faq-heading" class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl">
				Často kladené otázky
			</h2>
			<p class="mt-4 text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">
				Zhrnuli sme najčastejšie otázky, ktoré tímy riešia pred nasadením TaskFlow AI.
			</p>
		</div>

		<div class="mt-10 space-y-4 sm:mt-12">
			{faqs.map((faq, index) => (
				<article
					class="faq-item rounded-2xl border border-white/10 bg-white/5 transition duration-200 hover:border-white/20"
					data-faq-item
				>
					<h3>
						<button
							type="button"
							class="faq-trigger flex w-full items-center justify-between gap-3 px-4 py-4 text-left sm:gap-4 sm:px-6 sm:py-5"
							aria-expanded="false"
							aria-controls={`faq-answer-${index}`}
							id={`faq-trigger-${index}`}
						>
							<span class="text-sm font-semibold text-white sm:text-base lg:text-lg">{faq.question}</span>
							<span class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-indigo-400/20 bg-indigo-400/10 text-indigo-300 transition duration-200">
								<svg class="faq-icon-plus h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M10 4v12M4 10h12" />
								</svg>
								<svg class="faq-icon-minus hidden h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12" />
								</svg>
							</span>
						</button>
					</h3>

					<div
						id={`faq-answer-${index}`}
						class="faq-panel overflow-hidden transition-[max-height,opacity] duration-300 ease-out"
						style="max-block-size: 0px; opacity: 0;"
						role="region"
						aria-labelledby={`faq-trigger-${index}`}
					>
						<div class="px-4 pb-4 sm:px-6 sm:pb-5">
							<p class="text-sm leading-6 text-slate-300 sm:leading-7 sm:text-base">{faq.answer}</p>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-item]'));

	function setItemState(item: HTMLElement, expanded: boolean) {
		const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
		const panel = item.querySelector<HTMLElement>('.faq-panel');
		const plusIcon = item.querySelector<HTMLElement>('.faq-icon-plus');
		const minusIcon = item.querySelector<HTMLElement>('.faq-icon-minus');
		const iconWrap = item.querySelector<HTMLElement>('.faq-icon');

		if (!trigger || !panel || !plusIcon || !minusIcon || !iconWrap) return;

		const answer = panel.querySelector<HTMLElement>('div');
		const height = answer ? answer.scrollHeight : 0;

		trigger.setAttribute('aria-expanded', String(expanded));
		panel.style.maxHeight = expanded ? `${height}px` : '0px';
		panel.style.opacity = expanded ? '1' : '0';
		plusIcon.classList.toggle('hidden', expanded);
		minusIcon.classList.toggle('hidden', !expanded);
		iconWrap.classList.toggle('border-indigo-400/40', expanded);
		iconWrap.classList.toggle('bg-indigo-400/20', expanded);
		iconWrap.classList.toggle('text-indigo-200', expanded);
		item.classList.toggle('border-indigo-400/30', expanded);
		item.classList.toggle('bg-white/10', expanded);
	}

	items.forEach((item) => {
		const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
		const panel = item.querySelector<HTMLElement>('.faq-panel');

		if (!trigger || !panel) return;

		setItemState(item, trigger.getAttribute('aria-expanded') === 'true');

		trigger.addEventListener('click', () => {
			const shouldExpand = trigger.getAttribute('aria-expanded') !== 'true';

			if (shouldExpand) {
				items.forEach((otherItem) => {
					if (otherItem === item) return;
					setItemState(otherItem, false);
				});
			}

			setItemState(item, shouldExpand);
		});
	});
</script>
