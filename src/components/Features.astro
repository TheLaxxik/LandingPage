---
const features = [
	{
		title: 'Automatizácia úloh pomocou AI',
		description:
			'Nechajte TaskFlow AI triediť úlohy, navrhovať priority a odhaľovať zdržania skôr, než ovplyvnia tím.',
		icon: 'automation',
	},
	{
		title: 'Analytika v reálnom čase',
		description:
			'Získajte okamžitý prehľad o stave projektov, vyťažení tímu a rizikách v jednom prehľadnom dashboarde.',
		icon: 'analytics',
	},
	{
		title: 'Inteligentné upozornenia',
		description:
			'Buďte v obraze vďaka upozorneniam na termíny, blokéry a zmeny stavu, ktoré prichádzajú presne vtedy, keď ich potrebujete.',
		icon: 'notifications',
	},
];
---

<section
	class="border-t border-white/10 bg-slate-950 py-20 sm:py-28"
	aria-labelledby="features-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.25em] text-indigo-300">Funkcie</p>
			<h2 id="features-heading" class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl">
				Všetko, čo tím potrebuje na rýchlejšiu prácu
			</h2>
			<p class="mt-4 text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">
				TaskFlow AI spája automatizáciu, prehľady aj komunikáciu do jedného moderného pracovného priestoru.
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
			{features.map((feature, index) => (
				<article
					class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-1 hover:border-indigo-400/30 hover:bg-white/10 sm:p-8"
				>
					<div class="flex items-start justify-between gap-4">
						<span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-500/10 text-indigo-300 ring-1 ring-indigo-400/20 transition group-hover:bg-indigo-500/20 group-hover:text-indigo-200">
							{feature.icon === 'automation' && (
								<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v4m0 10v4M5.64 5.64l2.83 2.83m7.06 7.06 2.83 2.83M3 12h4m10 0h4M5.64 18.36l2.83-2.83m7.06-7.06 2.83-2.83" />
								</svg>
							)}
							{feature.icon === 'analytics' && (
								<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h16M8 15v-3m4 3V8m4 7v-5" />
								</svg>
							)}
							{feature.icon === 'notifications' && (
								<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.5-1.5A2 2 0 0118 14V10a6 6 0 10-12 0v4a2 2 0 01-.5 1.5L4 17h5m6 0a3 3 0 11-6 0" />
								</svg>
							)}
						</span>
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">0{index + 1}</span>
					</div>

					<h3 class="mt-6 text-lg font-semibold tracking-tight text-white sm:text-xl">{feature.title}</h3>
					<p class="mt-3 text-sm leading-7 text-slate-300 sm:text-base">{feature.description}</p>
				</article>
			))}
		</div>
	</div>
</section>
