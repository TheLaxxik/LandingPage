---
const footerLinks = [
	{ href: '#funkcie', label: 'Funkcie' },
	{ href: '#cennik', label: 'Cenník' },
	{ href: '#faq', label: 'FAQ' },
];

const email = 'info@taskflow.sk';
---

<footer class="border-t border-white/10 bg-slate-950">
	<section class="py-12 sm:py-16 lg:py-24" aria-labelledby="footer-heading">
		<div class="mx-auto grid max-w-7xl gap-10 px-4 text-center sm:px-6 lg:grid-cols-[1.4fr_1fr] lg:px-8 lg:text-left">
			<div>
				<p class="text-sm font-semibold uppercase tracking-[0.25em] text-indigo-300">TaskFlow AI</p>
				<h2 id="footer-heading" class="mx-auto mt-4 max-w-xl text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:mx-0">
					Pripravení zjednodušiť riadenie práce vo vašom tíme?
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-slate-300 sm:text-base sm:leading-8 lg:mx-0">
					Získajte nové funkcie, produktové tipy a praktické odporúčania priamo do schránky.
				</p>

				<form class="mx-auto mt-8 flex max-w-xl flex-col gap-3 sm:flex-row lg:mx-0">
					<label class="sr-only" for="newsletter-email">E-mail</label>
					<input id="newsletter-email" type="email" placeholder="Zadajte e-mail" class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder:text-slate-500 focus:border-indigo-400 focus:outline-none" />
					<button type="submit" class="rounded-xl bg-indigo-500 px-6 py-3 font-semibold text-white transition hover:bg-indigo-400">
						Odoberám novinky
					</button>
				</form>
			</div>

			<div class="grid gap-8 sm:grid-cols-2">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Navigácia</p>
					<nav class="mt-4">
						<ul class="flex flex-wrap justify-center gap-4 sm:gap-6 lg:justify-start lg:space-y-3 lg:gap-0 lg:flex-col">
							{footerLinks.map((link) => (
								<li>
									<a href={link.href} class="text-sm text-slate-300 transition hover:text-white">{link.label}</a>
								</li>
							))}
						</ul>
					</nav>
				</div>

				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Sociálne siete</p>
					<div class="mt-4 flex justify-center gap-3 lg:justify-start">
						<a href="#" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition hover:border-indigo-400/30 hover:text-white" aria-label="LinkedIn">
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9h4v12H3V9Zm7 0h3.8v1.64h.05c.53-1 1.83-2.05 3.77-2.05C21 8.59 21 11.16 21 14.5V21h-4v-5.7c0-1.36-.02-3.1-1.88-3.1-1.9 0-2.2 1.48-2.2 3v5.8h-4V9Z"/></svg>
						</a>
						<a href="#" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition hover:border-indigo-400/30 hover:text-white" aria-label="X">
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.9 7.9L23.3 22h-6.8l-5.3-6.9L4.8 22H1.7l7.4-8.4L.7 2H7.7l4.8 6.2L18.9 2Zm-1.2 18h1.8L6.6 3.9H4.6L17.7 20Z"/></svg>
						</a>
						<a href="#" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition hover:border-indigo-400/30 hover:text-white" aria-label="YouTube">
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 8s-.2-1.5-.8-2.2c-.8-.8-1.7-.8-2.1-.9C16 4.7 12 4.7 12 4.7h0s-4 0-6.9.2c-.4 0-1.3.1-2.1.9-.6.7-.8 2.2-.8 2.2S2 9.8 2 11.5v1c0 1.7.2 3.5.2 3.5s.2 1.5.8 2.2c.8.8 1.8.8 2.3.9 1.6.1 6.7.2 6.7.2s4 0 6.9-.2c.4 0 1.3-.1 2.1-.9.6-.7.8-2.2.8-2.2s.2-1.8.2-3.5v-1c0-1.7-.2-3.5-.2-3.5ZM10 14.8V8.7l5.8 3.1-5.8 3Z"/></svg>
						</a>
					</div>
					<p class="mt-5 text-sm text-slate-400 text-center lg:text-left">
						<a href={`mailto:${email}`} class="transition hover:text-white">{email}</a>
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="border-t border-white/10">
		<div class="mx-auto max-w-7xl px-4 py-6 text-center text-sm text-slate-500 sm:px-6 lg:px-8">
			© 2026 TaskFlow AI. Všetky práva vyhradené.
		</div>
	</div>
</footer>
