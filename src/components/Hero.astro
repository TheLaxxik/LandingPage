---
const primaryCta = { href: "/signup", label: "Začať bezplatnú skúšku" };
const secondaryCta = { href: "/demo", label: "Pozrieť demo" };

const stats = [
	{ value: "24%", label: "rýchlejšie doručenie" },
	{ value: "3,8 h", label: "ušetrených týždenne" },
	{ value: "98 %", label: "prijatie tímom" },
];
---

<section class="relative overflow-hidden bg-slate-950 py-16 sm:py-20 lg:py-28" aria-labelledby="hero-heading">
	<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(99,102,241,0.22),_transparent_34%),radial-gradient(circle_at_80%_20%,_rgba(168,85,247,0.18),_transparent_28%),linear-gradient(to_bottom,_rgba(15,23,42,0.92),_rgba(2,6,23,1))]"></div>
	<div class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-indigo-400/40 to-transparent"></div>

	<div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
		<div class="max-w-2xl">
			<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 shadow-[0_0_0_1px_rgba(255,255,255,0.02)] backdrop-blur">
				<span class="h-2 w-2 rounded-full bg-emerald-400"></span>
				TaskFlow AI pre moderné produktové tímy
			</div>

			<h1 id="hero-heading" class="text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-6xl">
				Maximalizujte produktivitu s AI
			</h1>

			<p class="mt-5 max-w-xl text-base leading-7 text-slate-300 sm:mt-6 sm:text-lg sm:leading-8">
				TaskFlow AI pomáha tímom plánovať, prioritizovať a dodávať rýchlejšie vďaka inteligentnej automatizácii úloh,
				prehľadom v reálnom čase a proaktívnym upozorneniam, ktoré udržiavajú prácu v pohybe.
			</p>

			<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
				<a
					href={primaryCta.href}
					class="inline-flex items-center justify-center rounded-xl bg-indigo-500 px-6 py-3.5 text-base font-semibold text-white shadow-[0_20px_40px_-18px_rgba(99,102,241,0.85)] transition duration-200 hover:-translate-y-0.5 hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
				>
					{primaryCta.label}
				</a>
				<a
					href={secondaryCta.href}
					class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition duration-200 hover:border-white/20 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/70"
				>
					{secondaryCta.label}
				</a>
			</div>

			<dl class="mt-10 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
				{stats.map((stat) => (
					<div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
						<dt class="text-sm text-slate-400">{stat.label}</dt>
						<dd class="mt-2 text-2xl font-semibold tracking-tight text-white">{stat.value}</dd>
					</div>
				))}
			</dl>
		</div>

		<div class="relative w-full">
			<div class="absolute -inset-6 rounded-[2rem] bg-indigo-500/20 blur-3xl"></div>
			<div
				class="relative w-full overflow-hidden rounded-[2rem] border border-white/10 bg-slate-900/80 p-4 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-6"
				aria-label="TaskFlow AI dashboard preview"
				role="img"
			>
				<div class="flex items-center justify-between border-b border-white/10 pb-4">
					<div>
						<p class="text-sm font-medium text-slate-400">TaskFlow AI</p>
						<p class="mt-1 text-lg font-semibold text-white">Týždenný prehľad tímu</p>
					</div>
					<div class="flex items-center gap-2 text-xs text-slate-300">
						<span class="rounded-full bg-emerald-400/15 px-3 py-1 text-emerald-300">Živá synchronizácia</span>
					</div>
				</div>

				<div class="mt-6 grid gap-4 sm:grid-cols-2">
					<div class="rounded-2xl border border-white/10 bg-white/5 p-4">
						<p class="text-sm text-slate-400">AI naplánované úlohy</p>
						<p class="mt-3 text-3xl font-semibold text-white">128</p>
						<div class="mt-4 h-2 rounded-full bg-slate-800">
							<div class="h-2 w-[78%] rounded-full bg-gradient-to-r from-indigo-400 to-purple-400"></div>
						</div>
					</div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-4">
						<p class="text-sm text-slate-400">Riziká označené AI</p>
						<p class="mt-3 text-3xl font-semibold text-white">12</p>
						<div class="mt-4 flex items-end gap-2">
							<div class="h-10 w-2 rounded-full bg-slate-700"></div>
							<div class="h-14 w-2 rounded-full bg-slate-700"></div>
							<div class="h-8 w-2 rounded-full bg-indigo-400"></div>
							<div class="h-18 w-2 rounded-full bg-purple-400"></div>
							<div class="h-12 w-2 rounded-full bg-slate-700"></div>
						</div>
					</div>
				</div>

				<div class="mt-4 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
					<div class="flex items-center justify-between gap-4">
						<div>
							<p class="text-sm font-medium text-white">AI plánovanie sprintu</p>
							<p class="mt-1 text-sm text-slate-400">Znovu rozložila záťaž medzi 4 členov tímu.</p>
						</div>
						<span class="rounded-full border border-indigo-400/30 bg-indigo-400/10 px-3 py-1 text-xs font-medium text-indigo-300">
							+18 % priepustnosť
						</span>
					</div>
					<div class="mt-4 grid gap-3 sm:grid-cols-3">
						<div class="rounded-xl bg-white/5 p-3">
							<p class="text-xs text-slate-400">Dnes</p>
							<p class="mt-2 text-sm font-medium text-white">8 úloh prioritizovaných</p>
						</div>
						<div class="rounded-xl bg-white/5 p-3">
							<p class="text-xs text-slate-400">AI prehľad</p>
							<p class="mt-2 text-sm font-medium text-white">2 blokéry vyriešené</p>
						</div>
						<div class="rounded-xl bg-white/5 p-3">
							<p class="text-xs text-slate-400">Ďalší krok</p>
							<p class="mt-2 text-sm font-medium text-white">Upozorniť dizajn tím</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>