---
import Logo from './Logo.astro';

const navLinks = [
	{ href: '#funkcie', label: 'Funkcie' },
	{ href: '#cennik', label: 'Cenník' },
	{ href: '#faq', label: 'Časté otázky' },
];

const cta = { href: '/signup', label: 'Začať zadarmo' };
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-md">
	<nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Hlavná navigácia">
		<Logo />

		<ul class="hidden items-center gap-1 md:flex">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="rounded-full px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden items-center gap-3 md:flex">
			<a
				href={cta.href}
				class="inline-flex items-center justify-center rounded-full bg-indigo-500 px-5 py-2.5 text-sm font-semibold text-white shadow-[0_16px_30px_-18px_rgba(99,102,241,0.9)] transition duration-200 hover:-translate-y-0.5 hover:bg-indigo-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
			>
				{cta.label}
			</a>
		</div>

		<button
			type="button"
			id="nav-toggle"
			class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 p-2 text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Otvoriť menu"
		>
			<svg id="nav-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg id="nav-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden max-h-0 overflow-hidden border-t border-white/10 bg-slate-950/90 opacity-0 transition-[max-height,opacity,transform] duration-300 ease-out md:hidden" role="region" aria-label="Mobilné menu">
		<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
			<ul class="flex flex-col gap-1">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="block rounded-2xl px-4 py-3 text-base font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li class="pt-2">
					<a
						href={cta.href}
						class="inline-flex w-full items-center justify-center rounded-full bg-indigo-500 px-5 py-3 text-sm font-semibold text-white shadow-[0_16px_30px_-18px_rgba(99,102,241,0.9)] transition duration-200 hover:bg-indigo-400"
					>
						{cta.label}
					</a>
				</li>
			</ul>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('mobile-menu');
	const iconOpen = document.getElementById('nav-icon-open');
	const iconClose = document.getElementById('nav-icon-close');
	const anchorLinks = document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
	let closeTimer: number | undefined;

	const closeMenu = (): void => {
		if (!toggle || !menu || !iconOpen || !iconClose) return;

		if (closeTimer) {
			window.clearTimeout(closeTimer);
		}

		menu.setAttribute('data-menu-open', 'false');
		menu.style.maxHeight = '0px';
		menu.style.opacity = '0';
		menu.style.transform = 'translateY(-8px)';
		iconOpen.classList.remove('hidden');
		iconClose.classList.add('hidden');
		toggle.setAttribute('aria-expanded', 'false');
		toggle.setAttribute('aria-label', 'Otvoriť menu');

		closeTimer = window.setTimeout(() => {
			if (menu.getAttribute('data-menu-open') === 'false') {
				menu.classList.add('hidden');
			}
		}, 300);
	};

	const openMenu = (): void => {
		if (!toggle || !menu || !iconOpen || !iconClose) return;

		if (closeTimer) {
			window.clearTimeout(closeTimer);
		}

		menu.classList.remove('hidden');
		menu.setAttribute('data-menu-open', 'true');
		menu.style.maxHeight = `${menu.scrollHeight}px`;
		menu.style.opacity = '1';
		menu.style.transform = 'translateY(0)';
		iconOpen.classList.add('hidden');
		iconClose.classList.remove('hidden');
		toggle.setAttribute('aria-expanded', 'true');
		toggle.setAttribute('aria-label', 'Zavrieť menu');
	};

	const scrollToAnchor = (targetId: string): boolean => {
		const target = document.querySelector(targetId);

		if (!target) return false;

		const header = document.querySelector('header');
		const headerOffset = header ? header.getBoundingClientRect().height : 0;
		const targetTop = target.getBoundingClientRect().top + window.scrollY;
		const offsetTop = Math.max(targetTop - headerOffset - 16, 0);

		window.scrollTo({
			top: offsetTop,
			behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
		});

		history.pushState(null, '', targetId);
		return true;
	};

	anchorLinks.forEach((link) => {
		link.addEventListener('click', (event) => {
			const href = link.getAttribute('href');

			if (!href || !href.startsWith('#')) return;

			const scrolled = scrollToAnchor(href);

			if (!scrolled) return;

			event.preventDefault();
			if (menu) {
				menu.setAttribute('data-menu-open', 'false');
			}
			closeMenu();
		});
	});

	if (toggle && menu && iconOpen && iconClose) {
		toggle.addEventListener('click', () => {
			const isOpen = menu.getAttribute('data-menu-open') === 'true';
			if (isOpen) {
				closeMenu();
			} else {
				openMenu();
			}
		});
	}
</script>
