---
const plans = [
	{
		name: 'Základ',
		monthly: '0 €',
		annually: '0 €',
		description: 'Pre menšie tímy, ktoré chcú vyskúšať TaskFlow AI bez rizika.',
		features: ['1 tím', 'Základná AI prioritizácia', 'Jednoduché dashboardy', 'E-mailová podpora'],
		cta: 'Začať zadarmo',
		featured: false,
	},
	{
		name: 'Pro',
		monthly: '29 €',
		annually: '24 €',
		description: 'Najpopulárnejší plán pre rastúce tímy, ktoré chcú automatizáciu a prehľady v reálnom čase.',
		features: ['Neobmedzené projekty', 'Pokročilá AI automatizácia', 'Analytika v reálnom čase', 'Prioritná podpora'],
		cta: 'Začať s Pro',
		featured: true,
	},
	{
		name: 'Enterprise',
		monthly: 'Kontakt',
		annually: 'Kontakt',
		description: 'Pre firmy, ktoré potrebujú bezpečnosť, onboarding a riešenie na mieru.',
		features: ['Všetko z Pro', 'SSO a pokročilé oprávnenia', 'Vyhradený onboarding', 'SLA a dedikovaná podpora'],
		cta: 'Kontaktovať predaj',
		featured: false,
	},
];
---

<section id="cennik" class="border-t border-white/10 bg-slate-950 py-16 sm:py-20 lg:py-28" aria-labelledby="pricing-heading">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.25em] text-indigo-300">Cenník</p>
			<h2 id="pricing-heading" class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl">
				Transparentné ceny podľa toho, ako rýchlo chcete rásť
			</h2>
			<p class="mt-4 text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">
				Zvoľte mesačné alebo ročné fakturovanie a nájdite plán, ktorý sedí vášmu tímu aj rozpočtu.
			</p>
		</div>

		<div class="mt-8 flex justify-center">
			<div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm" role="tablist" aria-label="Prepínač fakturácie">
				<button type="button" class="billing-toggle rounded-full px-5 py-2 text-sm font-semibold text-white transition data-[active=true]:bg-indigo-500 data-[active=true]:shadow-[0_14px_30px_-18px_rgba(99,102,241,0.85)]" data-billing-toggle data-billing="monthly" aria-pressed="true">
					Mesačne
				</button>
				<button type="button" class="billing-toggle rounded-full px-5 py-2 text-sm font-semibold text-slate-300 transition data-[active=true]:bg-indigo-500 data-[active=true]:text-white data-[active=true]:shadow-[0_14px_30px_-18px_rgba(99,102,241,0.85)]" data-billing-toggle data-billing="yearly" aria-pressed="false">
					Ročne
				</button>
			</div>
		</div>

		<div class="mt-10 grid gap-4 md:grid-cols-2 xl:mt-14 xl:grid-cols-3 xl:gap-6">
			{
				plans.map((plan) => (
					<article
						class:list={[
							'relative rounded-3xl border p-6 shadow-2xl shadow-black/20 transition duration-200 hover:-translate-y-1 sm:p-8',
							plan.featured
								? 'border-indigo-400/40 bg-gradient-to-b from-indigo-500/15 to-slate-900 ring-1 ring-indigo-400/30'
								: 'border-white/10 bg-white/5 backdrop-blur-sm',
						]}
						data-plan-card
						data-plan-name={plan.name}
					>
						{plan.featured && (
							<div class="absolute right-6 top-6 rounded-full bg-indigo-400 px-3 py-1 text-xs font-semibold text-white">
								Najpopulárnejšie
							</div>
						)}

						<h3 class="text-lg font-semibold text-white sm:text-xl">{plan.name}</h3>
						<p class="mt-3 text-sm leading-6 text-slate-300 sm:text-base">{plan.description}</p>

						<div class="mt-6 flex items-end gap-2">
							<span class="text-3xl font-semibold tracking-tight text-white sm:text-4xl" data-price-monthly={plan.monthly} data-price-yearly={plan.annually}>{plan.monthly}</span>
							<span class="pb-1 text-sm text-slate-400" data-period>{plan.name === 'Enterprise' ? 'na mieru' : '/mesačne'}</span>
						</div>

						<ul class="mt-8 space-y-3 text-sm text-slate-200">
							{plan.features.map((feature) => (
								<li class="flex items-start gap-3">
									<span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-400/15 text-emerald-300">
										<svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
											<path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.25 7.25a1 1 0 01-1.42 0l-3.25-3.25a1 1 0 111.42-1.42l2.54 2.54 6.54-6.54a1 1 0 011.42 0z" clip-rule="evenodd" />
										</svg>
									</span>
									<span>{feature}</span>
								</li>
							))}
						</ul>

						<a
							href="/signup"
							class:list={[
								'mt-8 inline-flex w-full items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold transition duration-200',
								plan.featured
									? 'bg-indigo-500 text-white shadow-[0_18px_40px_-20px_rgba(99,102,241,0.95)] hover:bg-indigo-400'
									: 'bg-white/10 text-white hover:bg-white/15',
							]}
						>
							{plan.cta}
						</a>
					</article>
				))
			}
		</div>
	</div>

	<script>
		const toggleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-billing-toggle]'));
		const planCards = Array.from(document.querySelectorAll<HTMLElement>('[data-plan-card]'));

		function updateBilling(mode: 'monthly' | 'yearly') {
			toggleButtons.forEach((button) => {
				const active = button.getAttribute('data-billing') === mode;
				button.dataset.active = String(active);
				button.setAttribute('aria-pressed', String(active));
			});

			planCards.forEach((card) => {
				const price = card.querySelector<HTMLElement>('[data-price-monthly]');
				const period = card.querySelector<HTMLElement>('[data-period]');
				const name = card.getAttribute('data-plan-name');

				if (!price || !period || !name) return;

				const monthly = price.getAttribute('data-price-monthly') || '';
				const yearly = price.getAttribute('data-price-yearly') || '';

				if (name === 'Enterprise') {
					price.textContent = 'Kontakt';
					period.textContent = 'na mieru';
					return;
				}

				if (mode === 'yearly') {
					price.textContent = yearly;
					period.textContent = '/mesiac pri ročnej platbe';
				} else {
					price.textContent = monthly;
					period.textContent = '/mesačne';
				}
			});
		}

		updateBilling('monthly');

		toggleButtons.forEach((button) => {
			button.addEventListener('click', () => {
				updateBilling(button.getAttribute('data-billing') === 'yearly' ? 'yearly' : 'monthly');
			});
		});
	</script>
</section>
